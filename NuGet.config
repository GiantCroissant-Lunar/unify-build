<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources for this repo are declared ONCE at the lunar-horse workspace root:
      <workspace-root>/nuget.config   (regenerate with `task feed:provision`)
  NuGet finds it by walking up the directory tree, and its `lunar-horse-local` feed path
  resolves relative to the root — so it works from a normal checkout AND from git worktrees
  at any depth, cross-platform (no /Users/... or C:\... committed anywhere).

  Intentionally NO <packageSources> and NO <clear/> here: a <clear/> would wipe the
  inherited root sources and reintroduce the worktree feed-resolution failure. See
  yokan-projects/README.md for the rationale.
-->
<configuration>
</configuration>
